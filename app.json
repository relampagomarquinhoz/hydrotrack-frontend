{
  "expo": {
    "name": "HydroTrack",
    "slug": "hydrotrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1565C0"
      },
      "package": "com.hydrotrack.app"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hydrotrack.app"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1565C0"
        }
      ]
    ],
    "scheme": "hydrotrack"
  }
}